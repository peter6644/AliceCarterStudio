# Copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Never prefix with NEXT_PUBLIC_, never commit, never paste in chat.
SUPABASE_SERVICE_ROLE_KEY=
